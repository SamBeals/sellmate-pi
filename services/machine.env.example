# Canonical per-machine SellMate Pi identity and cloud settings.
# Installed to: /etc/sellmate/machine.env
# Used by: sellmate-poller.service and sellmate-health.service
#
# 1. Copy this file (setup.sh does this if missing).
# 2. Set a UNIQUE MACHINE_ID for this Pi (required; no default).
# 3. Set MACHINE_SHARED_TOKEN to match Cloud Run (never commit real tokens).
# 4. sudo chmod 600 /etc/sellmate/machine.env
# 5. sudo systemctl daemon-reload
# 6. sudo systemctl restart sellmate-poller sellmate-health

MACHINE_ID=machine_001
CLOUD_BASE=https://sellmatecloud-1002770348452.us-west4.run.app
MACHINE_SHARED_TOKEN=CHANGE_ME

# Optional FEATURE-013 commissioning knobs (also usable from vend-api env):
# TECHNICIAN_PIN=4130
# COMMISSIONING_CLOUD_PUBLISH=true
# COMMISSIONING_COMMANDS_ENABLED=true
# COMMISSIONING_SIMULATION=false
#
# INA226 common-shunt motor current monitor (default address from live Pi test):
# INA226_ENABLED=true
# INA226_I2C_BUS=1
# INA226_I2C_ADDRESS=0x40
# Optional calibrated shunt ohms for amperage; detection uses shunt volts either way.
# INA226_SHUNT_OHMS=0.1
# CURRENT_SAMPLE_INTERVAL_MS=50
# CURRENT_DETECTION_THRESHOLD_V=0.002
# CURRENT_REQUIRED_SAMPLES=3
# COMMISSIONING_PROBE_SECONDS=0.75
# COMMISSIONING_REQUIRE_CURRENT_SENSOR=true
