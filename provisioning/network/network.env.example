# SellMate preferred-uplink networking (NetworkManager).
# Installed to: /etc/sellmate/network.env (mode 644)
# Sourced by provisioning/network/install-preferred-uplink.sh and verify script.
#
# Prefer the router/LTE uplink (usually Ethernet to a Spitz or similar) over
# Wi-Fi by giving preferred profiles a lower ipv4.route-metric. Both remain
# autoconnect-enabled so failover/failback is automatic.
#
# IMPORTANT: Quote every value (as the installer does with shell_quote).
# Connection names often contain spaces.

# Comma-separated NetworkManager connection names for the preferred uplink.
# Empty = all profiles with TYPE=802-3-ethernet.
SELLMATE_PREFERRED_CONNECTIONS=''

# Comma-separated NetworkManager Wi-Fi connection names (fallback).
# Empty = all profiles with TYPE=802-11-wireless.
SELLMATE_WIFI_CONNECTIONS=''

# Lower metric wins the default route. Preferred must be strictly less than Wi-Fi.
SELLMATE_PREFERRED_METRIC='100'
SELLMATE_WIFI_METRIC='700'
